import os
import sqlite3
import logging
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes, MessageHandler, filters, ConversationHandler

logging.basicConfig(format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO)

# ЗАМЕНИ ЭТИ ДВЕ СТРОКИ НА СВОИ ЗНАЧЕНИЯ!
TOKEN = "9021976633:AAHCa3ZGNbb0RBPWkgV40IS-UeB70DpNFrU"
ADMIN_CHAT_ID = 795845732  # Твой ID

NAME, PHONE, ADDRESS, CUSTOM_TEXT = range(4)

def get_product(pid):
    if not os.path.exists("database.db"): return None
    conn = sqlite3.connect("database.db")
    conn.row_factory = sqlite3.Row
    p = conn.execute("SELECT * FROM products WHERE id=?", (pid,)).fetchone()
    conn.close()
    return p

async def start(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    args = ctx.args
    
    # --- Свободный заказ ---
    if args and args[0] == "custom_order":
        await update.message.reply_text("✨ Напишите, что вы хотите заказать или какой у вас вопрос:")
        return CUSTOM_TEXT

    # --- Корзина ---
    elif args and args[0].startswith("buy_cart_"):
        try:
            ids_str = args[0].replace("buy_cart_", "")
            ids = [int(i) for i in ids_str.split(",")]
            cart_titles, total_price = [], 0
            for pid in ids:
                p = get_product(pid)
                if p:
                    cart_titles.append(f"• {p['title']} ({p['price']} ₽)")
                    total_price += p['price']
            
            if not cart_titles:
                await update.message.reply_text("Товары не найдены в базе 😔")
                return ConversationHandler.END
                
            ctx.user_data["product"] = {"title": "Заказ:\n" + "\n".join(cart_titles), "price": total_price, "id": ids_str}
            await update.message.reply_text(f"🛍 *Ваш заказ:*\n\n" + "\n".join(cart_titles) + f"\n\n💰 Итого: {total_price} ₽\n\nКак вас зовут?", parse_mode="Markdown")
            return NAME
        except:
            await update.message.reply_text("Ошибка корзины 😔")
            return ConversationHandler.END

    # --- Один товар ---
    elif args and args[0].startswith("buy_"):
        try:
            pid = int(args[0].replace("buy_", ""))
            p = get_product(pid)
            if not p:
                await update.message.reply_text("Товар не найден в базе 😔")
                return ConversationHandler.END
            ctx.user_data["product"] = dict(p)
            await update.message.reply_text(f"🛍 *{p['title']}*\n\n💰 Цена: {p['price']} ₽\n\nКак вас зовут?", parse_mode="Markdown")
            return NAME
        except:
            await update.message.reply_text("Ошибка данных товара 😔")
            return ConversationHandler.END
        
    # --- Обычный старт ---
    await update.message.reply_text("Добро пожаловать в *EUPHORIC* ✨\n\nВыберите товар на сайте.", parse_mode="Markdown")
    return ConversationHandler.END

async def get_custom_text(update, ctx):
    ctx.user_data["custom_order"] = update.message.text
    await update.message.reply_text("Как вас зовут?")
    return NAME

async def get_name(update, ctx):
    ctx.user_data["name"] = update.message.text
    await update.message.reply_text("Ваш телефон?")
    return PHONE

async def get_phone(update, ctx):
    ctx.user_data["phone"] = update.message.text
    await update.message.reply_text("Адрес доставки?")
    return ADDRESS

async def get_address(update, ctx):
    ctx.user_data["address"] = update.message.text
    d = ctx.user_data
    
    if "custom_order" in d:
        order = (f"✉️ *СВОБОДНЫЙ ЗАКАЗ*\n\nЗапрос: {d['custom_order']}\n\nИмя: {d['name']}\nТелефон: {d['phone']}\nАдрес: {d['address']}\nUsername: @{update.effective_user.username or '—'}")
    else:
        p = d["product"]
        order = (f"🆕 *НОВЫЙ ЗАКАЗ*\n\nТовар: {p['title']}\nЦена: {p['price']} ₽\n\nИмя: {d['name']}\nТелефон: {d['phone']}\nАдрес: {d['address']}\nUsername: @{update.effective_user.username or '—'}")
             
    await ctx.bot.send_message(ADMIN_CHAT_ID, order, parse_mode="Markdown")
    await update.message.reply_text("Спасибо! Заказ принят ✅")
    return ConversationHandler.END

async def cancel(update, ctx):
    await update.message.reply_text("Отменено.")
    return ConversationHandler.END

app = ApplicationBuilder().token(TOKEN).build()
conv = ConversationHandler(
    entry_points=[CommandHandler("start", start)],
    states={
        NAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_name)],
        PHONE: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_phone)],
        ADDRESS: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_address)],
        CUSTOM_TEXT: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_custom_text)],
    },
    fallbacks=[CommandHandler("cancel", cancel)],
)
app.add_handler(conv)
app.run_polling()
