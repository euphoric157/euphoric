import os
import sqlite3
import logging
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes, MessageHandler, filters, ConversationHandler

logging.basicConfig(format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO)

TOKEN = os.environ.get("BOT_TOKEN", "9021976633:AAHCa3ZGNbb0RBPWkgV40IS-UeB70DpNFrU")
ADMIN_CHAT_ID = int(os.environ.get("ADMIN_CHAT_ID", 0))

NAME, PHONE, ADDRESS = range(3)

def get_product(pid):
    if not os.path.exists("database.db"): return None
    conn = sqlite3.connect("database.db")
    conn.row_factory = sqlite3.Row
    p = conn.execute("SELECT * FROM products WHERE id=?", (pid,)).fetchone()
    conn.close()
    return p

async def start(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    args = ctx.args
    if args and args[0].startswith("buy_cart_"):
        items_str = args[0].replace("buy_cart_", "")
        items = items_str.split(",")
        
        cart_titles = []
        total_price = 0
        
        for item in items:
            parts = item.split("_")
            if len(parts) >= 3:
                title = parts[1].replace("%20", " ")
                price = int(parts[2])
                cart_titles.append(f"• {title} ({price} ₽)")
                total_price += price
        
        if not cart_titles:
            await update.message.reply_text("Ошибка корзины 😔")
            return ConversationHandler.END
            
        ctx.user_data["product"] = {
            "title": "Ваш заказ:\n" + "\n".join(cart_titles), 
            "price": total_price, 
            "id": "cart"
        }
        await update.message.reply_text(
            f"🛍 *Ваш заказ:*\n\n" + "\n".join(cart_titles) + f"\n\n💰 Итого: {total_price} ₽\n\nКак вас зовут?", 
            parse_mode="Markdown"
        )
        return NAME

    elif args and args[0].startswith("buy_"):
        parts = args[0].replace("buy_", "").split("_")
        if len(parts) >= 3:
            title = parts[1].replace("%20", " ")
            price = int(parts[2])
            
            ctx.user_data["product"] = {"title": title, "price": price, "id": parts[0]}
            await update.message.reply_text(
                f"🛍 *{title}*\n\n💰 Цена: {price} ₽\n\nКак вас зовут?", 
                parse_mode="Markdown"
            )
            return NAME
        else:
            await update.message.reply_text("Ошибка данных товара 😔")
            return ConversationHandler.END
        
    await update.message.reply_text(
        "Добро пожаловать в *EUPHORIC* ✨\n\nВыберите товар на сайте.", 
        parse_mode="Markdown"
    )
    return ConversationHandler.END

async def get_name(update, ctx):
    ctx.user_data["name"] = update.message.text
    await update.message.reply_text("Ваш телефон для связи?")
    return PHONE

async def get_phone(update, ctx):
    ctx.user_data["phone"] = update.message.text
    await update.message.reply_text("Адрес доставки или «самовывоз»?")
    return ADDRESS

async def get_address(update, ctx):
    ctx.user_data["address"] = update.message.text
    d = ctx.user_data
    p = d["product"]
    
    try:
        conn = sqlite3.connect("database.db")
        ids = str(p['id']).split(',')
        for pid in ids:
            if pid.strip().isdigit():
                conn.execute("UPDATE products SET sales = sales + 1 WHERE id=?", (int(pid),))
        conn.commit()
        conn.close()
    except Exception as e:
        print("Ошибка при обновлении счетчика продаж:", e)

    order = (f"🆕 *НОВЫЙ ЗАКАЗ*\n\n"
             f"Товар: {p['title']} (ID {p['id']})\n"
             f"Цена: {p['price']} ₽\n\n"
             f"Имя: {d['name']}\nТелефон: {d['phone']}\nАдрес: {d['address']}\n"
             f"Username: @{update.effective_user.username or '—'}")
             
    await ctx.bot.send_message(ADMIN_CHAT_ID, order, parse_mode="Markdown")
    await update.message.reply_text("Спасибо! Заказ принят ✅\nМы свяжемся с вами в ближайшее время.")
    return ConversationHandler.END

async def cancel(update, ctx):
    await update.message.reply_text("Отменено.")
    return ConversationHandler.END

app = ApplicationBuilder().token(TOKEN).build()
conv = ConversationHandler(
    entry_points=[CommandHandler("start", start)],
    states={
        NAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_name)],
        PHONE: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_phone)],
        ADDRESS: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_address)],
    },
    fallbacks=[CommandHandler("cancel", cancel)],
)
app.add_handler(conv)
app.run_polling()
